<Window x:Class="OcrSearch.App.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OcrSearch"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="BorderBrush" Value="#C9D1D9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#24292F" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryDialogButton" TargetType="Button" BasedOn="{StaticResource DialogButton}">
            <Setter Property="Background" Value="#1F6FEB" />
            <Setter Property="BorderBrush" Value="#1F6FEB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Border Background="#FAFBFC"
            BorderBrush="#D0D7DE"
            BorderThickness="1"
            CornerRadius="6"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              ShadowDepth="4"
                              Opacity="0.22" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Background="#F6F8FA"
                       LastChildFill="True"
                       MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right"
                        Content="X"
                        Width="34"
                        Height="30"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#57606A"
                        Click="Secondary_Click" />
                <TextBlock x:Name="TitleText"
                           Margin="14,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#24292F" />
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="18,16,18,18">
                <TextBlock x:Name="HeadingText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#24292F"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText"
                           Margin="0,8,0,0"
                           Foreground="#57606A"
                           LineHeight="19"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="2"
                    Background="#F6F8FA"
                    BorderBrush="#D8DEE4"
                    BorderThickness="0,1,0,0"
                    Padding="12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SecondaryButton"
                            Style="{StaticResource DialogButton}"
                            IsCancel="True"
                            Click="Secondary_Click" />
                    <Button x:Name="PrimaryButton"
                            Style="{StaticResource PrimaryDialogButton}"
                            IsDefault="True"
                            Click="Primary_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
